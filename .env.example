# Copy to `.env` and edit the two URLs. `docker compose` loads this file.

# Where colleagues add the index source. Must be reachable from their machines,
# must answer http(s) directly (no redirects), and must not sit behind SSO.
MARKET_URL=https://market.acme.internal

# Where DSH installs packages from. Also client-reachable.
NPM_REGISTRY_URL=https://npm.acme.internal/

# Package scope new plugins are published under.
MARKET_SCOPE=@acme-community

MARKET_TITLE_ZH=公司插件市场
MARKET_TITLE_EN=Acme DSH plugins
MARKET_DESC_ZH=同事做的工作台插件，装了就能用
MARKET_DESC_EN=Workbench plugins built by colleagues

# Comma-separated author names that get the `official` label.
OFFICIAL_AUTHORS=
